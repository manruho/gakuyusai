{
  "name": "gakuyusai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "cf:check:pages": "wrangler pages functions build functions --outdir .wrangler/deploy-check/pages",
    "cf:check:realtime": "wrangler deploy --config wrangler.realtime.jsonc --dry-run --strict --outdir .wrangler/deploy-check/realtime",
    "cf:preflight": "npm run typecheck && npm run lint && npm test && npm run test:worker && npm run build && npm run cf:check:pages && npm run cf:check:realtime",
    "cf:deploy:realtime": "wrangler deploy --config wrangler.realtime.jsonc --strict",
    "cf:deploy:pages": "wrangler pages deploy dist --project-name gakuyusai --branch main",
    "cf:deploy": "npm run cf:preflight && npm run db:migrate:remote && npm run cf:deploy:realtime && npm run cf:deploy:pages",
    "cf:secrets:list": "wrangler pages secret list --project-name gakuyusai",
    "db:create": "wrangler d1 create gakuyusai",
    "db:migration:create": "wrangler d1 migrations create gakuyusai",
    "db:migrate:local": "wrangler d1 migrations apply gakuyusai --local",
    "db:migrate:remote": "wrangler d1 migrations apply gakuyusai --remote",
    "db:migrations:list:remote": "wrangler d1 migrations list gakuyusai --remote",
    "db:list": "wrangler d1 list",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest tests/unit",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "hono": "^4.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.0",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.127.1"
  }
}
